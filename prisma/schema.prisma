// ==============================================================================
// SCHOOLNEXA — ENTERPRISE DATABASE SCHEMA (PRISMA v5/v6)
// Authoritative Architecture: v3.3.1 (115 Physical Tables)
// Database Engine: MySQL 8.0+
// Isolation Model: Shared DB / Shared Schema / Application-Level Multi-Tenancy
// Foreign Key Mode: Native Foreign Keys (relationMode = "foreignKeys")
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "foreignKeys"
}

// ==========================================
// 1. PLATFORM SCOPE (7 Tables)
// ==========================================

model SubscriptionPlan {
  id String @id @default(uuid()) @db.VarChar(36)

  name String @db.VarChar(100)

  code String @unique @db.VarChar(50)

  description String? @db.Text

  price Decimal @db.Decimal(10, 2)

  currency String @default("USD") @db.VarChar(3)

  billingCycle String @map("billing_cycle") @db.VarChar(20) // MONTHLY, ANNUAL

  maxStudents Int @default(500) @map("max_students")

  maxStaff Int @default(50) @map("max_staff")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  features SubscriptionFeature[]

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model SubscriptionFeature {
  id String @id @default(uuid()) @db.VarChar(36)

  planId String @map("plan_id") @db.VarChar(36)

  featureKey String @map("feature_key") @db.VarChar(100)

  featureValue String? @map("feature_value") @db.VarChar(255)

  isEnabled Boolean @default(true) @map("is_enabled")

  createdAt DateTime @default(now()) @map("created_at")

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@map("subscription_features")
}

model Subscription {
  id String @id @default(uuid()) @db.VarChar(36)

  schoolId String @map("school_id") @db.VarChar(36)

  planId String @map("plan_id") @db.VarChar(36)

  status String @default("TRIALING") @db.VarChar(30) // TRIALING, ACTIVE, PAST_DUE, CANCELLED

  currentPeriodStart DateTime @map("current_period_start")

  currentPeriodEnd DateTime @map("current_period_end")

  cancelAtPeriodEnd Boolean @default(false) @map("cancel_at_period_end")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  invoices SubscriptionInvoice[]

  // Required candidate key for tenant-safe composite child relations.
  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([planId])
  @@map("subscriptions")
}

model SubscriptionInvoice {
  id String @id @default(uuid()) @db.VarChar(36)

  schoolId String @map("school_id") @db.VarChar(36)

  subscriptionId String @map("subscription_id") @db.VarChar(36)

  invoiceNumber String @unique @map("invoice_number") @db.VarChar(50)

  subtotal Decimal @db.Decimal(10, 2)

  taxAmount Decimal @default(0.00) @map("tax_amount") @db.Decimal(10, 2)

  totalAmount Decimal @map("total_amount") @db.Decimal(10, 2)

  status String @default("DRAFT") @db.VarChar(30) // DRAFT, ISSUED, PAID, VOID

  dueDate DateTime @map("due_date")

  paidAt DateTime? @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  // IMPORTANT:
  // Tenant-safe relation. Both school_id and subscription_id
  // must match the parent Subscription.
  subscription Subscription @relation(fields: [schoolId, subscriptionId], references: [schoolId, id], onDelete: Restrict)

  items SubscriptionInvoiceItem[]

  payments SubscriptionPayment[]

  @@unique([schoolId, id])
  @@index([schoolId])
  @@index([schoolId, subscriptionId])
  @@index([subscriptionId])
  @@map("subscription_invoices")
}

model SubscriptionInvoiceItem {
  id String @id @default(uuid()) @db.VarChar(36)

  schoolId String @map("school_id") @db.VarChar(36)

  invoiceId String @map("invoice_id") @db.VarChar(36)

  description String @db.VarChar(255)

  quantity Int @default(1)

  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)

  amount Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")

  invoice SubscriptionInvoice @relation(fields: [schoolId, invoiceId], references: [schoolId, id], onDelete: Cascade)

  @@index([schoolId, invoiceId])
  @@map("subscription_invoice_items")
}

model SubscriptionPayment {
  id String @id @default(uuid()) @db.VarChar(36)

  schoolId String @map("school_id") @db.VarChar(36)

  invoiceId String @map("invoice_id") @db.VarChar(36)

  amount Decimal @db.Decimal(10, 2)

  paymentMethod String @map("payment_method") @db.VarChar(50)

  transactionRef String? @map("transaction_ref") @db.VarChar(100)

  status String @default("SUCCESS") @db.VarChar(30)

  paidAt DateTime @default(now()) @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at")

  invoice SubscriptionInvoice @relation(fields: [schoolId, invoiceId], references: [schoolId, id], onDelete: Restrict)

  @@index([schoolId, invoiceId])
  @@map("subscription_payments")
}

model PaymentWebhookEvent {
  id String @id @default(uuid()) @db.VarChar(36)

  schoolId String? @map("school_id") @db.VarChar(36)

  provider String @db.VarChar(50) // STRIPE, RAZORPAY, FLUTTERWAVE

  eventId String @map("event_id") @db.VarChar(150)

  eventType String @map("event_type") @db.VarChar(100)

  payload String @db.LongText

  status String @default("RECEIVED") @db.VarChar(30) // RECEIVED, PROCESSING, PROCESSED, FAILED

  processedAt DateTime? @map("processed_at")

  createdAt DateTime @default(now()) @map("created_at")

  school School? @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@unique([provider, eventId], map: "uq_webhooks_provider_event")
  @@index([schoolId])
  @@map("payment_webhook_events")
}

// ==========================================
// 2. GLOBAL SCOPE (6 Tables)
// ==========================================

model User {
  id String @id @default(uuid()) @db.VarChar(36)

  email String @unique(map: "uq_users_email") @db.VarChar(191)

  passwordHash String @map("password_hash") @db.VarChar(255)

  fullName String @map("full_name") @db.VarChar(150)

  phone String? @db.VarChar(30)

  avatarUrl String? @map("avatar_url") @db.VarChar(500)

  isSuperAdmin Boolean @default(false) @map("is_super_admin")

  isActive Boolean @default(true) @map("is_active")

  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  sessions Session[]

  passwordResets PasswordReset[]

  schoolMemberships SchoolUser[]

  staffProfiles Staff[]

  studentProfiles Student[]

  parentProfile Parent?

  sentMessages InternalMessage[] @relation("SentInternalMessages")

  receivedMessages InternalMessageRecipient[] @relation("RecipientInternalMessages")

  notifications Notification[]

  activityLogs ActivityLog[]

  historicalChangeRecords HistoricalChangeRecord[]

  @@map("users")
}

model Session {
  id String @id @default(uuid()) @db.VarChar(36)

  userId String @map("user_id") @db.VarChar(36)

  sessionToken String @unique @map("session_token") @db.VarChar(255)

  ipAddress String? @map("ip_address") @db.VarChar(45)

  userAgent String? @db.Text

  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordReset {
  id String @id @default(uuid()) @db.VarChar(36)

  userId String @map("user_id") @db.VarChar(36)

  tokenHash String @unique @map("token_hash") @db.VarChar(255)

  expiresAt DateTime @map("expires_at")

  usedAt DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model Permission {
  id String @id @default(uuid()) @db.VarChar(36)

  code String @unique @db.VarChar(100)

  module String @db.VarChar(50)

  action String @db.VarChar(50)

  description String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model StudentIdentity {
  id String @id @default(uuid()) @db.VarChar(36)

  nationalId String @unique(map: "uq_student_identities_national_id") @map("national_id") @db.VarChar(100)

  idType String @default("NATIONAL_ID") @map("id_type") @db.VarChar(50)

  birthCertNo String? @map("birth_cert_no") @db.VarChar(100)

  nationality String @default("US") @db.VarChar(50)

  countryOfBirth String? @map("country_of_birth") @db.VarChar(50)

  verifiedAt DateTime? @map("verified_at")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  students Student[]

  @@map("student_identities")
}

model Parent {
  id String @id @default(uuid()) @db.VarChar(36)

  userId String? @unique @map("user_id") @db.VarChar(36)

  primaryPhone String @map("primary_phone") @db.VarChar(30)

  alternatePhone String? @map("alternate_phone") @db.VarChar(30)

  occupation String? @db.VarChar(100)

  annualIncome Decimal? @map("annual_income") @db.Decimal(12, 2)

  currentAddress String? @map("current_address") @db.Text

  permanentAddress String? @map("permanent_address") @db.Text

  emergencyContact String? @map("emergency_contact") @db.VarChar(100)

  emergencyPhone String? @map("emergency_phone") @db.VarChar(30)

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  children ParentStudent[]

  @@map("parents")
}

// ==========================================
// 3. MIXED SCOPE (1 Table)
// ==========================================

model StoredFile {
  id String @id @default(uuid()) @db.VarChar(36)

  schoolId String? @map("school_id") @db.VarChar(36)

  storageKey String @unique @map("storage_key") @db.VarChar(255)

  fileName String @map("file_name") @db.VarChar(255)

  fileSize BigInt @map("file_size")

  mimeType String @map("mime_type") @db.VarChar(100)

  bucket String @db.VarChar(100)

  isPublic Boolean @default(false) @map("is_public")

  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  school School? @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  studentDocuments StudentDocument[]

  homeworkAttachments HomeworkAttachment[]

  homeworkSubmissionAttachments HomeworkSubmissionAttachment[]

  @@index([schoolId])
  @@map("stored_files")
}

// ==========================================
// 4. SCHOOL CORE SCOPE (31 Tables)
// ==========================================

model School {
  id         String    @id @default(uuid()) @db.VarChar(36)
  name       String    @db.VarChar(150)
  code       String    @unique @db.VarChar(50)
  domain     String?   @unique @db.VarChar(100)
  address    String    @db.Text
  city       String    @db.VarChar(100)
  state      String    @db.VarChar(100)
  country    String    @default("US") @db.VarChar(50)
  postalCode String    @map("postal_code") @db.VarChar(20)
  phone      String    @db.VarChar(30)
  email      String    @db.VarChar(191)
  currency   String    @default("USD") @db.VarChar(3)
  timezone   String    @default("UTC") @db.VarChar(50)
  logoUrl    String?   @map("logo_url") @db.VarChar(500)
  status     String    @default("ACTIVE") @db.VarChar(30)
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  // Relations
  subscriptions           Subscription[]
  subscriptionInvoices    SubscriptionInvoice[]
  paymentWebhookEvents    PaymentWebhookEvent[]
  storedFiles             StoredFile[]
  settings                SchoolSetting[]
  academicYears           AcademicYear[]
  roles                   Role[]
  schoolUsers             SchoolUser[]
  students                Student[]
  classes                 Class[]
  subjects                Subject[]
  feeTypes                FeeType[]
  feePayments             FeePayment[]
  gradingScales           GradingScale[]
  examTypes               ExamType[]
  rooms                   Room[]
  periodDefinitions       PeriodDefinition[]
  departments             Department[]
  designations            Designation[]
  staffMembers            Staff[]
  leaveTypes              LeaveType[]
  books                   Book[]
  libraryMembers          LibraryMember[]
  digitalBooks            DigitalBook[]
  vehicles                Vehicle[]
  drivers                 Driver[]
  routes                  Route[]
  hostelBlocks            HostelBlock[]
  assetCategories         AssetCategory[]
  fixedAssets             FixedAsset[]
  vendors                 Vendor[]
  purchaseOrders          PurchaseOrder[]
  expenseCategories       ExpenseCategory[]
  announcements           Announcement[]
  events                  Event[]
  internalConversations   InternalConversation[]
  notificationTemplates   NotificationTemplate[]
  notifications           Notification[]
  activityLogs            ActivityLog[]
  historicalChangeRecords HistoricalChangeRecord[]
  enrollments             Enrollment[]
  promotionBatches        PromotionBatch[]

  @@map("schools")
}

model SchoolSetting {
  id           String   @id @default(uuid()) @db.VarChar(36)
  schoolId     String   @map("school_id") @db.VarChar(36)
  settingKey   String   @map("setting_key") @db.VarChar(100)
  settingValue String   @map("setting_value") @db.Text
  dataType     String   @default("STRING") @map("data_type") @db.VarChar(30)
  isEncrypted  Boolean  @default(false) @map("is_encrypted")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, settingKey])
  @@map("school_settings")
}

model AcademicYear {
  id        String   @id @default(uuid()) @db.VarChar(36)
  schoolId  String   @map("school_id") @db.VarChar(36)
  name      String   @db.VarChar(100)
  code      String   @db.VarChar(50)
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isCurrent Boolean  @default(false) @map("is_current")
  status    String   @default("UPCOMING") @db.VarChar(30) // UPCOMING, ACTIVE, CLOSED
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school               School                @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYearSections AcademicYearSection[]
  enrollments          Enrollment[]
  promotionBatches     PromotionBatch[]
  feeStructures        FeeStructure[]
  exams                Exam[]
  syllabi              Syllabus[]

  @@unique([schoolId, id])
  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("academic_years")
}

model Role {
  id          String   @id @default(uuid()) @db.VarChar(36)
  schoolId    String   @map("school_id") @db.VarChar(36)
  name        String   @db.VarChar(100)
  code        String   @db.VarChar(50)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]
  userSchoolRoles UserSchoolRole[]

  @@unique([schoolId, id])
  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("roles")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.VarChar(36)
  schoolId     String   @map("school_id") @db.VarChar(36)
  roleId       String   @map("role_id") @db.VarChar(36)
  permissionId String   @map("permission_id") @db.VarChar(36)
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [schoolId, roleId], references: [schoolId, id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([schoolId, roleId, permissionId])
  @@index([schoolId, roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model SchoolUser {
  id        String    @id @default(uuid()) @db.VarChar(36)
  schoolId  String    @map("school_id") @db.VarChar(36)
  userId    String    @map("user_id") @db.VarChar(36)
  status    String    @default("ACTIVE") @db.VarChar(30)
  joinedAt  DateTime  @default(now()) @map("joined_at")
  leftAt    DateTime? @map("left_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  school    School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userRoles UserSchoolRole[]

  @@unique([schoolId, id])
  @@unique([schoolId, userId])
  @@index([schoolId])
  @@index([userId])
  @@map("school_users")
}

model UserSchoolRole {
  id           String   @id @default(uuid()) @db.VarChar(36)
  schoolId     String   @map("school_id") @db.VarChar(36)
  schoolUserId String   @map("school_user_id") @db.VarChar(36)
  roleId       String   @map("role_id") @db.VarChar(36)
  createdAt    DateTime @default(now()) @map("created_at")

  schoolUser SchoolUser @relation(fields: [schoolId, schoolUserId], references: [schoolId, id], onDelete: Cascade)
  role       Role       @relation(fields: [schoolId, roleId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, schoolUserId, roleId])
  @@index([schoolId, schoolUserId])
  @@index([schoolId, roleId])
  @@map("user_school_roles")
}

model Student {
  id                         String    @id @default(uuid()) @db.VarChar(36)
  schoolId                   String    @map("school_id") @db.VarChar(36)
  studentIdentityId          String    @map("student_identity_id") @db.VarChar(36)
  userId                     String?   @map("user_id") @db.VarChar(36)
  admissionNumber            String    @map("admission_number") @db.VarChar(64)
  registrationId             String?   @map("registration_id") @db.VarChar(64)
  firstName                  String    @map("first_name") @db.VarChar(100)
  middleName                 String?   @map("middle_name") @db.VarChar(100)
  lastName                   String    @map("last_name") @db.VarChar(100)
  photoUrl                   String?   @map("photo_url") @db.VarChar(500)
  gender                     String    @db.VarChar(20)
  dateOfBirth                DateTime  @map("date_of_birth") @db.Date
  bloodGroup                 String?   @map("blood_group") @db.VarChar(10)
  specialCategory            String?   @map("special_category") @db.VarChar(100)
  specialCategoryDetails     String?   @map("special_category_details") @db.Text
  nationality                String?   @default("Indian") @db.VarChar(50)
  religion                   String?   @db.VarChar(50)
  category                   String?   @db.VarChar(50)
  motherTongue               String?   @map("mother_tongue") @db.VarChar(50)
  placeOfBirth               String?   @map("place_of_birth") @db.VarChar(100)
  governmentId               String?   @map("government_id") @db.VarChar(100)
  mobile                     String?   @db.VarChar(30)
  alternateMobile            String?   @map("alternate_mobile") @db.VarChar(30)
  email                      String?   @db.VarChar(191)
  address                    String    @db.Text
  addressLine1               String?   @map("address_line1") @db.VarChar(255)
  addressLine2               String?   @map("address_line2") @db.VarChar(255)
  city                       String    @db.VarChar(100)
  state                      String    @db.VarChar(100)
  country                    String?   @default("India") @db.VarChar(100)
  postalCode                 String    @map("postal_code") @db.VarChar(20)
  previousSchool             String?   @map("previous_school") @db.VarChar(200)
  previousClass              String?   @map("previous_class") @db.VarChar(50)
  previousSchoolBoard        String?   @map("previous_school_board") @db.VarChar(100)
  transferCertificateNumber  String?   @map("transfer_certificate_number") @db.VarChar(100)
  transferCertificateDate    DateTime? @map("transfer_certificate_date") @db.Date
  notes                      String?   @db.Text
  status                     String    @default("ACTIVE") @db.VarChar(30)
  emergencyContact           String    @map("emergency_contact") @db.VarChar(100)
  emergencyPhone             String    @map("emergency_phone") @db.VarChar(30)
  activeAdmissionNumber      String?   @map("active_admission_number") @db.VarChar(64)
  deletedAt                  DateTime? @map("deleted_at")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  school               School                @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  identity             StudentIdentity       @relation(fields: [studentIdentityId], references: [id], onDelete: Restrict)
  user                 User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  documents            StudentDocument[]
  parents              ParentStudent[]
  enrollments          Enrollment[]
  transferCertificates TransferCertificate[]
  feeConcessions       FeeConcession[]

  @@unique([schoolId, id])
  @@unique([schoolId, activeAdmissionNumber], map: "uq_students_active_admission")
  @@unique([schoolId, registrationId], map: "uq_students_registration_id")
  @@index([schoolId])
  @@index([studentIdentityId])
  @@index([userId])
  @@map("students")
}

model StudentDocument {
  id             String    @id @default(uuid()) @db.VarChar(36)
  schoolId       String    @map("school_id") @db.VarChar(36)
  studentId      String    @map("student_id") @db.VarChar(36)
  storedFileId   String    @map("stored_file_id") @db.VarChar(36)
  documentType   String    @map("document_type") @db.VarChar(50)
  documentNumber String?   @map("document_number") @db.VarChar(100)
  verifiedAt     DateTime? @map("verified_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  student    Student    @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade)
  storedFile StoredFile @relation(fields: [storedFileId], references: [id], onDelete: Restrict)

  @@index([schoolId, studentId])
  @@index([storedFileId])
  @@map("student_documents")
}

model TransferCertificate {
  id                String   @id @default(uuid()) @db.VarChar(36)
  schoolId          String   @map("school_id") @db.VarChar(36)
  studentId         String   @map("student_id") @db.VarChar(36)
  certificateNumber String   @map("certificate_number") @db.VarChar(100)
  issueDate         DateTime @map("issue_date") @db.Date
  reasonForLeaving  String   @map("reason_for_leaving") @db.Text
  conductRemarks    String?  @map("conduct_remarks") @db.VarChar(255)
  status            String   @default("ISSUED") @db.VarChar(30)
  createdAt         DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, certificateNumber])
  @@index([schoolId, studentId])
  @@map("transfer_certificates")
}

model ParentStudent {
  id               String   @id @default(uuid()) @db.VarChar(36)
  schoolId         String   @map("school_id") @db.VarChar(36)
  parentId         String   @map("parent_id") @db.VarChar(36)
  studentId        String   @map("student_id") @db.VarChar(36)
  relationship     String   @db.VarChar(50) // FATHER, MOTHER, GUARDIAN
  isPrimaryContact Boolean  @default(true) @map("is_primary_contact")
  canPickup        Boolean  @default(true) @map("can_pickup")
  createdAt        DateTime @default(now()) @map("created_at")

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Cascade)

  @@unique([schoolId, parentId, studentId])
